# Redis Online Shop - environment variables
# Copy this file to .env and fill in real values before running locally.

SERVER_PORT=8080
LOG_LEVEL=INFO

DB_HOST=localhost
DB_PORT=3306
DB_NAME=online_shop
DB_USERNAME=root
DB_PASSWORD=your_db_password_here

REDIS_HOST=localhost
REDIS_PORT=6379

JWT_SECRET=your-32-character-secret-key-here

ORDER_STREAM_KEY=stream:orders
ORDER_CONSUMER_GROUP=order-service
ORDER_CONSUMER_NAME=order-service-1
ORDER_DEAD_LETTER_STREAM_KEY=stream:orders:dlq
ORDER_EVENT_CONSUMER_ENABLED=true
ORDER_EVENT_POLL_DELAY_MS=3000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
CACHE_WARMUP_ENABLED=true
CACHE_WARMUP_INITIAL_DELAY_MS=30000
CACHE_WARMUP_FIXED_DELAY_MS=300000
