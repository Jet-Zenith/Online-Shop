# ===========================================
# Redis Online Shop - 环境变量配置模板
# ===========================================
# 复制此文件为 .env，填入真实值后启动应用。
# .env 文件已在 .gitignore 中排除，不会被提交。

# 服务端口
SERVER_PORT=8080

# MySQL 数据库
DB_HOST=localhost
DB_PORT=3306
DB_NAME=online_shop
DB_USERNAME=root
DB_PASSWORD=your_db_password_here

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT 签名密钥（至少 32 字符）
JWT_SECRET=your-32-character-secret-key-here
