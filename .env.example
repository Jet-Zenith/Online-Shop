# Redis Online Shop - environment variables
# Copy this file to .env and fill in real values before running locally.

SERVER_PORT=8080
LOG_LEVEL=INFO

DB_HOST=localhost
DB_PORT=3306
DB_NAME=online_shop
DB_USERNAME=root
DB_PASSWORD=your_db_password_here

REDIS_HOST=localhost
REDIS_PORT=6379

ELASTICSEARCH_ENABLED=true
ELASTICSEARCH_URIS=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

JWT_SECRET=your-32-character-secret-key-here

ORDER_STREAM_KEY=stream:orders
ORDER_EVENT_BACKEND=rocketmq
ORDER_CONSUMER_GROUP=order-service
ORDER_CONSUMER_NAME=order-service-1
ORDER_DEAD_LETTER_STREAM_KEY=stream:orders:dlq
ORDER_EVENT_CONSUMER_ENABLED=true
ORDER_EVENT_POLL_DELAY_MS=3000
ROCKETMQ_NAME_SERVER=localhost:9876
ROCKETMQ_PRODUCER_GROUP=redis-online-shop-producer
ROCKETMQ_ORDER_TOPIC=shop-order-events
ROCKETMQ_ORDER_CREATED_TAG=ORDER_CREATED
ROCKETMQ_ORDER_CONSUMER_GROUP=shop-order-event-consumer
LOW_STOCK_THRESHOLD=5
OUTBOX_ENABLED=true
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_RETRIES=5
OUTBOX_RELAY_DELAY_MS=5000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
CACHE_WARMUP_ENABLED=true
CACHE_WARMUP_INITIAL_DELAY_MS=30000
CACHE_WARMUP_FIXED_DELAY_MS=300000
